# ── Hookline Backend Environment ──
# Copy to .env and fill in. Never commit .env.

# Database
DATABASE_URL=postgresql+asyncpg://hookline:hookline@localhost:5432/hookline

# Redis
REDIS_URL=redis://localhost:6379/0

# Security
JWT_SECRET=change-me-in-production-min-32-chars
API_KEY_PREFIX=hl_

# Encryption key for storing CRM tokens (Fernet — generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
TOKEN_ENCRYPTION_KEY=

# ── GoHighLevel ──
GHL_CLIENT_ID=
GHL_CLIENT_SECRET=
GHL_REDIRECT_URI=http://localhost:8000/oauth/ghl/callback
GHL_API_BASE=https://services.leadconnectorhq.com
GHL_OAUTH_BASE=https://marketplace.leadconnectorhq.com/oauth

# ── Microsoft Dynamics 365 ──
DYNAMICS_CLIENT_ID=
DYNAMICS_CLIENT_SECRET=
DYNAMICS_TENANT_ID=
DYNAMICS_REDIRECT_URI=http://localhost:8000/oauth/dynamics/callback
DYNAMICS_SCOPE=https://org.crm.dynamics.com/.default
DYNAMICS_RESOURCE_URL=
DYNAMICS_OAUTH_BASE=https://login.microsoftonline.com

# ── Twilio (Voice) ──
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ── OpenAI ──
OPENAI_API_KEY=

# ── App ──
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=info
